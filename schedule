    // View Navigation
    function switchView(viewName) {
      if (viewName === 'matchmaker') {
        document.getElementById('viewMatchmaker').classList.remove('hidden');
        document.getElementById('viewWorkingSchedule').classList.add('hidden');
        document.getElementById('navMatchmaker').className = 'nav-tab active flex items-center gap-2 px-4 py-2 rounded-lg bg-white text-indigo-700 shadow-xs transition';
        document.getElementById('navWorkingSchedule').className = 'nav-tab flex items-center gap-2 px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition';
        renderSlots();
      } else {
        document.getElementById('viewMatchmaker').classList.add('hidden');
        document.getElementById('viewWorkingSchedule').classList.remove('hidden');
        document.getElementById('navMatchmaker').className = 'nav-tab flex items-center gap-2 px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition';
        document.getElementById('navWorkingSchedule').className = 'nav-tab active flex items-center gap-2 px-4 py-2 rounded-lg bg-white text-indigo-700 shadow-xs transition';
        renderWorkingScheduleTable();
      }
      lucide.createIcons();
    }

    function updateGlobalCounters() {
      const openCount = CRIMSON_SLOTS.filter(s => s.status === 'open').length;
      const bookedCount = CRIMSON_SLOTS.filter(s => s.status === 'booked').length;

      document.getElementById('statOpenSlots').innerText = openCount;
      document.getElementById('tabOpenBadge').innerText = `${openCount} TBD`;
      document.getElementById('countFilterTBD').innerText = openCount;
      document.getElementById('countFilterLocked').innerText = bookedCount;
      document.getElementById('summaryConfirmed').innerText = `${bookedCount} Games`;
      document.getElementById('summaryPending').innerText = `${openCount} Slots`;
    }

    function filterSlots(type) {
      currentFilter = type;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        if (btn.dataset.filter === type) {
          btn.className = 'filter-btn active flex-1 py-1.5 px-2 rounded-lg bg-white text-indigo-700 font-bold text-center shadow-xs transition';
        } else {
          btn.className = 'filter-btn flex-1 py-1.5 px-2 rounded-lg text-slate-600 hover:text-slate-900 font-semibold text-center transition';
        }
      });
      renderSlots();
    }

    function setParityFilter(filterType) {
      currentParityFilter = filterType;
      document.querySelectorAll('.parity-btn').forEach(btn => {
        if (btn.dataset.parity === filterType) {
          btn.className = 'parity-btn active px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 font-bold';
        } else {
          btn.className = 'parity-btn px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 font-medium';
        }
      });
      const slot = CRIMSON_SLOTS.find(s => s.id === currentSelectedSlotId);
      const avail = AVAILABILITY_DATA[slot.id] || { open: [], flexible: [] };
      renderOpponentCards(avail, slot);
    }

    function renderSlots() {
      const container = document.getElementById('slotList');
      container.innerHTML = '';

      const filtered = CRIMSON_SLOTS.filter(s => {
        if (currentFilter === 'tbd') return s.status === 'open';
        if (currentFilter === 'booked') return s.status === 'booked';
        return true;
      });

      filtered.forEach(slot => {
        const isSelected = slot.id === currentSelectedSlotId;
        const avail = AVAILABILITY_DATA[slot.id] || { open: [], flexible: [] };
        const totalMatches = avail.open.length + avail.flexible.length;

        const card = document.createElement('div');
        card.className = `p-3.5 rounded-2xl border transition cursor-pointer ${
          isSelected 
            ? 'bg-indigo-50/70 border-indigo-500/80 shadow-md shadow-indigo-100 ring-2 ring-indigo-500/20' 
            : 'bg-white border-slate-200/80 hover:border-slate-300 hover:shadow-xs'
        }`;
        card.onclick = () => selectSlot(slot.id);

        card.innerHTML = `
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[11px] font-bold ${isSelected ? 'text-indigo-700' : 'text-slate-500'}">Slot #${slot.id}</span>
            ${slot.status === 'open' 
              ? `<span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">${totalMatches} Matches</span>`
              : `<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200 flex items-center gap-1"><i data-lucide="lock" class="w-3 h-3 text-emerald-600"></i> Locked</span>`
            }
          </div>
          <div class="text-xs font-extrabold text-slate-900 mb-0.5">${slot.displayDate}</div>
          <div class="text-[11px] text-slate-600 flex items-center gap-1.5 mb-2 font-medium">
            <i data-lucide="clock" class="w-3 h-3 text-slate-400"></i> ${slot.time}
          </div>
          <div class="text-[11px] flex items-center justify-between border-t border-slate-100 pt-2 mt-1">
            <span>${slot.status === 'open' ? '<span class="text-rose-600 font-bold flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>Needs Opponent</span>' : `<span class="text-slate-800 font-bold text-[11px] truncate max-w-[170px] inline-block">${slot.opponent}</span>`}</span>
            <span class="text-[10px] text-slate-400 font-medium">${slot.format}</span>
          </div>
        `;
        container.appendChild(card);
      });
      lucide.createIcons();
    }

    function selectSlot(slotId) {
      currentSelectedSlotId = slotId;
      renderSlots();

      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;

      document.getElementById('activeSlotBadge').innerText = `Slot #${slot.id} Selected`;
      document.getElementById('activeSlotDate').innerText = `${slot.displayDate}`;
      document.getElementById('activeSlotTitle').innerHTML = `
        ${slot.time} @ ${slot.rink}
        ${slot.status === 'booked' ? `<span class="text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 ml-2 flex items-center gap-1.5 inline-flex"><i data-lucide="lock" class="w-3.5 h-3.5"></i> Locked: ${slot.opponent}</span>` : ''}
      `;
      document.getElementById('heatmapDate').innerText = slot.displayDate;

      const avail = AVAILABILITY_DATA[slot.id] || { open: [], flexible: [], conflicted: DIVISION_TEAMS };
      
      document.getElementById('countFullyOpen').innerText = avail.open.length;
      document.getElementById('countFlexible').innerText = avail.flexible.length;
      document.getElementById('countConflicted').innerText = avail.conflicted.length;

      renderOpponentCards(avail, slot);
      renderConflictMatrix(slot, avail);
    }

    function renderOpponentCards(avail, slot) {
      const container = document.getElementById('opponentCards');
      container.innerHTML = '';

      if (slot.status === 'booked') {
        const mhr = MHR_TEAM_DATA[slot.opponent];
        container.innerHTML = `
          <div class="col-span-2 bg-white border border-emerald-200 rounded-2xl p-6 shadow-xs flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600">
                <i data-lucide="lock" class="w-6 h-6"></i>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-[10px] uppercase font-bold tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Slot Confirmed & Locked</span>
                  ${mhr ? `<span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200 cursor-pointer hover:bg-amber-100" onclick="openMHRDossier('${slot.opponent}')">MHR: ${mhr.rating} (${mhr.rank})</span>` : ''}
                </div>
                <h4 class="text-lg font-black text-slate-900 mt-1">${slot.opponent}</h4>
                <p class="text-xs text-slate-500">${slot.format} Game @ ${slot.rink} • ${slot.time}</p>
              </div>
            </div>
            <button onclick="unlockSlot(${slot.id})" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-rose-50 hover:text-rose-700 text-xs font-bold text-slate-700 border border-slate-200 hover:border-rose-200 transition flex items-center gap-2">
              <i data-lucide="unlock" class="w-4 h-4"></i> Unlock / Re-open Slot
            </button>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      // Filter by Parity
      let openMatches = [...avail.open];
      let flexMatches = [...avail.flexible];

      if (currentParityFilter === 'tight') {
        openMatches = openMatches.filter(t => Math.abs(MHR_TEAM_DATA[t]?.diff || 0) <= 2.0);
        flexMatches = flexMatches.filter(f => Math.abs(MHR_TEAM_DATA[f.team]?.diff || 0) <= 2.0);
      } else if (currentParityFilter === 'moderate') {
        openMatches = openMatches.filter(t => Math.abs(MHR_TEAM_DATA[t]?.diff || 0) > 2.0 && Math.abs(MHR_TEAM_DATA[t]?.diff || 0) <= 4.0);
        flexMatches = flexMatches.filter(f => Math.abs(MHR_TEAM_DATA[f.team]?.diff || 0) > 2.0 && Math.abs(MHR_TEAM_DATA[f.team]?.diff || 0) <= 4.0);
      }

      if (openMatches.length === 0 && flexMatches.length === 0) {
        container.innerHTML = `
          <div class="col-span-2 bg-white border border-slate-200 rounded-2xl p-8 text-center shadow-xs">
            <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3 text-slate-400">
              <i data-lucide="calendar-x" class="w-6 h-6"></i>
            </div>
            <h4 class="text-sm font-extrabold text-slate-900">No Opponents Matching Current Filter</h4>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Try setting the Parity Filter to "All" or explore other ice slots on your schedule.</p>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      // Render Fully Available Opponents
      openMatches.forEach(team => {
        const mhr = MHR_TEAM_DATA[team] || { rating: "N/A", rank: "N/A", diff: 0, record: "N/A" };
        const diffText = mhr.diff >= 0 ? `+${mhr.diff}` : `${mhr.diff}`;
        const isTight = Math.abs(mhr.diff) <= 2.0;

        const card = document.createElement('div');
        card.className = "bg-white border border-emerald-200/90 rounded-2xl p-5 flex flex-col justify-between hover:border-emerald-400 transition shadow-xs hover:shadow-md";
        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1">
                <i data-lucide="check-circle" class="w-3 h-3 text-emerald-600"></i> 100% Fully Available
              </span>
              <button onclick="openMHRDossier('${team}')" class="text-xs font-bold text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-200 px-2.5 py-0.5 rounded-full flex items-center gap-1 transition">
                <i data-lucide="award" class="w-3 h-3 text-amber-600"></i> MHR: ${mhr.rating} (${mhr.rank})
              </button>
            </div>
            <h4 class="text-sm font-extrabold text-slate-900 mb-1">${team}</h4>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-[11px] font-bold ${isTight ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-slate-600 bg-slate-100 border-slate-200'} px-2 py-0.5 rounded border">
                Parity &Delta;: ${diffText}
              </span>
              <span class="text-[11px] text-slate-500 font-medium">Record: ${mhr.record}</span>
            </div>
            <p class="text-xs text-slate-500 mb-3.5">Zero games scheduled all day. Clean calendar match with no travel friction.</p>
          </div>
          <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] text-slate-500 font-semibold flex items-center gap-1.5"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-indigo-600"></i> ${slot.rink}</span>
            <button onclick="promptLockOpponent(${slot.id}, '${team}', '${slot.displayDate}', '${slot.time}')" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-xs font-bold text-white shadow-sm transition flex items-center gap-1.5">
              <i data-lucide="lock" class="w-3.5 h-3.5"></i> Lock into Schedule
            </button>
          </div>
        `;
        container.appendChild(card);
      });

      // Render Flexible Same-Day Opponents
      flexMatches.forEach(item => {
        const mhr = MHR_TEAM_DATA[item.team] || { rating: "N/A", rank: "N/A", diff: 0, record: "N/A" };
        const diffText = mhr.diff >= 0 ? `+${mhr.diff}` : `${mhr.diff}`;
        const isTight = Math.abs(mhr.diff) <= 2.0;

        const card = document.createElement('div');
        card.className = "bg-white border border-amber-200/90 rounded-2xl p-5 flex flex-col justify-between hover:border-amber-400 transition shadow-xs hover:shadow-md";
        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200 flex items-center gap-1">
                <i data-lucide="clock" class="w-3 h-3 text-amber-600"></i> Same-Day Feasible (&ge;4h)
              </span>
              <button onclick="openMHRDossier('${item.team}')" class="text-xs font-bold text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-200 px-2.5 py-0.5 rounded-full flex items-center gap-1 transition">
                <i data-lucide="award" class="w-3 h-3 text-amber-600"></i> MHR: ${mhr.rating}
              </button>
            </div>
            <h4 class="text-sm font-extrabold text-slate-900 mb-1">${item.team}</h4>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[11px] font-bold ${isTight ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-slate-600 bg-slate-100 border-slate-200'} px-2 py-0.5 rounded border">
                Parity &Delta;: ${diffText}
              </span>
              <span class="text-[11px] text-amber-700 font-bold bg-amber-50 px-2 py-0.5 rounded border border-amber-200">${item.restHours}</span>
            </div>
            <p class="text-xs text-slate-500 mb-1.5">Plays prior match: <span class="text-slate-800 font-semibold">${item.priorGame}</span></p>
            <p class="text-[11px] text-emerald-600 font-medium flex items-center gap-1"><i data-lucide="shield-check" class="w-3.5 h-3.5"></i> Complies with &ge;4h rest buffer</p>
          </div>
          <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between mt-3">
            <span class="text-[11px] text-slate-500 font-medium">Rest interval: ${item.restHours}</span>
            <button onclick="promptLockOpponent(${slot.id}, '${item.team}', '${slot.displayDate}', '${slot.time}')" class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-xs font-bold text-white transition flex items-center gap-1.5">
              <i data-lucide="lock" class="w-3.5 h-3.5"></i> Lock into Schedule
            </button>
          </div>
        `;
        container.appendChild(card);
      });

      lucide.createIcons();
    }

    function renderConflictMatrix(slot, avail) {
      const tbody = document.getElementById('matrixTableBody');
      tbody.innerHTML = '';

      DIVISION_TEAMS.forEach(team => {
        const isOpen = avail.open.includes(team);
        const flexItem = avail.flexible.find(f => f.team === team);
        const mhr = MHR_TEAM_DATA[team];
        const diffText = mhr.diff >= 0 ? `+${mhr.diff}` : `${mhr.diff}`;
        const isTight = Math.abs(mhr.diff) <= 2.0;

        let statusBadge = '';
        let bufferText = '<span class="text-emerald-700 font-bold">&ge; 4.0h (100% Free)</span>';
        let actionBtn = `<button onclick="promptLockOpponent(${slot.id}, '${team}', '${slot.displayDate}', '${slot.time}')" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">Lock Match</button>`;

        if (isOpen) {
          statusBadge = '<span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-200">Fully Available</span>';
        } else if (flexItem) {
          statusBadge = '<span class="px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 text-[10px] font-bold border border-amber-200">Flexible (&ge;4h)</span>';
          bufferText = `<span class="text-amber-700 font-bold">${flexItem.restHours}</span>`;
          actionBtn = `<button onclick="promptLockOpponent(${slot.id}, '${team}', '${slot.displayDate}', '${slot.time}')" class="text-xs font-bold text-amber-600 hover:text-amber-800">Lock Match</button>`;
        } else {
          statusBadge = '<span class="px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 text-[10px] font-bold border border-rose-200">Conflicted</span>';
          bufferText = '<span class="text-rose-600 font-semibold">&lt; 4.0h / Conflict</span>';
          actionBtn = `<span class="text-slate-400 text-xs font-medium">Conflict</span>`;
        }

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50/70 transition";
        tr.innerHTML = `
          <td class="py-3 px-4 font-bold text-slate-800 cursor-pointer hover:text-indigo-600" onclick="openMHRDossier('${team}')">${team}</td>
          <td class="py-3 px-4">
            <span class="font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">${mhr.rating}</span>
            <span class="text-slate-500 font-medium ml-1">(${mhr.rank})</span>
          </td>
          <td class="py-3 px-4">
            <span class="font-bold ${isTight ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-slate-600 bg-slate-100 border-slate-200'} px-2 py-0.5 rounded border">
              ${diffText}
            </span>
          </td>
          <td class="py-3 px-4">${statusBadge}</td>
          <td class="py-3 px-4">${bufferText}</td>
          <td class="py-3 px-4 text-right">${actionBtn}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Working Schedule Table Rendering
    function renderWorkingScheduleTable() {
      const tbody = document.getElementById('workingScheduleTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      CRIMSON_SLOTS.forEach(slot => {
        const isLocked = slot.status === 'booked';
        const mhr = MHR_TEAM_DATA[slot.opponent];
        const tr = document.createElement('tr');
        tr.className = `hover:bg-indigo-50/30 transition ${isLocked ? 'bg-emerald-50/20' : ''}`;

        let opponentOptions = `<option value="TBD" ${slot.opponent === 'TBD' ? 'selected' : ''}>-- TBD (Select Opponent) --</option>`;
        if (slot.opponent.includes("Yale") || slot.opponent.includes("New England Stars")) {
          opponentOptions += `<option value="${slot.opponent}" selected>${slot.opponent}</option>`;
        }
        DIVISION_TEAMS.forEach(team => {
          opponentOptions += `<option value="${team}" ${slot.opponent === team ? 'selected' : ''}>${team} (MHR: ${MHR_TEAM_DATA[team].rating})</option>`;
        });

        let mhrDisplay = '<span class="text-slate-400 font-medium">Unassigned</span>';
        if (mhr) {
          const diffText = mhr.diff >= 0 ? `+${mhr.diff}` : `${mhr.diff}`;
          mhrDisplay = `
            <span class="font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 cursor-pointer hover:bg-amber-100" onclick="openMHRDossier('${slot.opponent}')">${mhr.rating}</span>
            <span class="font-semibold text-slate-600 ml-1">(&Delta; ${diffText})</span>
          `;
        } else if (isLocked) {
          mhrDisplay = '<span class="text-slate-500 font-medium">Exhibition Team</span>';
        }

        tr.innerHTML = `
          <td class="py-3.5 px-4 font-bold text-slate-900">#${slot.id}</td>
          <td class="py-3.5 px-4">
            <select onchange="updateSlotFormat(${slot.id}, this.value)" class="bg-white border border-slate-200 rounded-lg px-2 py-1 font-bold text-slate-700 focus:outline-none focus:border-indigo-600 shadow-2xs">
              <option value="HOME" ${slot.format === 'HOME' ? 'selected' : ''}>HOME</option>
              <option value="AWAY" ${slot.format === 'AWAY' ? 'selected' : ''}>AWAY</option>
            </select>
          </td>
          <td class="py-3.5 px-4 font-bold text-slate-800">${slot.displayDate}</td>
          <td class="py-3.5 px-4 text-indigo-700 font-bold whitespace-nowrap">${slot.time}</td>
          <td class="py-3.5 px-4">
            <input type="text" value="${slot.rink}" onchange="updateSlotRink(${slot.id}, this.value)" class="bg-transparent border-b border-transparent hover:border-slate-300 focus:border-indigo-600 focus:bg-white px-1 py-0.5 rounded text-slate-700 w-full focus:outline-none transition">
          </td>
          <td class="py-3.5 px-4">
            <select onchange="updateSlotOpponent(${slot.id}, this.value)" class="w-full bg-white border ${isLocked ? 'border-emerald-300 text-emerald-900 font-extrabold bg-emerald-50/50' : 'border-slate-200 text-slate-800 font-medium'} rounded-xl px-3 py-1.5 focus:outline-none focus:border-indigo-600 shadow-2xs transition">
              ${opponentOptions}
            </select>
          </td>
          <td class="py-3.5 px-4">${mhrDisplay}</td>
          <td class="py-3.5 px-4 text-center">
            ${isLocked 
              ? `<span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold border border-emerald-200 flex items-center gap-1 justify-center"><i data-lucide="check" class="w-3 h-3"></i> Locked</span>`
              : `<span class="px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 text-[10px] font-extrabold border border-rose-200">Open TBD</span>`
            }
          </td>
          <td class="py-3.5 px-4 text-right whitespace-nowrap">
            ${isLocked
              ? `<button onclick="unlockSlot(${slot.id})" class="text-xs font-bold text-rose-600 hover:text-rose-800 transition px-2 py-1 rounded hover:bg-rose-50">Clear / Unlock</button>`
              : `<button onclick="goToMatchmakerForSlot(${slot.id})" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition px-2 py-1 rounded hover:bg-indigo-50 flex items-center gap-1 ml-auto"><i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Find Teams</button>`
            }
          </td>
        `;
        tbody.appendChild(tr);
      });
      updateGlobalCounters();
      lucide.createIcons();
    }

    function updateSlotOpponent(slotId, newOpponent) {
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;
      slot.opponent = newOpponent;
      slot.status = (newOpponent === 'TBD' || newOpponent === '') ? 'open' : 'booked';
      
      renderWorkingScheduleTable();
      renderSlots();
      selectSlot(currentSelectedSlotId);
      showToast(`Slot #${slotId} updated: ${newOpponent}`);
    }

    function updateSlotFormat(slotId, newFormat) {
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;
      slot.format = newFormat;
      showToast(`Slot #${slotId} format updated to ${newFormat}`);
    }

    function updateSlotRink(slotId, newRink) {
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;
      slot.rink = newRink;
      showToast(`Slot #${slotId} venue updated to ${newRink}`);
    }

    function unlockSlot(slotId) {
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;
      slot.opponent = 'TBD';
      slot.status = 'open';

      renderWorkingScheduleTable();
      renderSlots();
      selectSlot(slotId);
      showToast(`Slot #${slotId} unlocked and reset to TBD`);
    }

    function goToMatchmakerForSlot(slotId) {
      switchView('matchmaker');
      selectSlot(slotId);
    }

    function promptLockOpponent(slotId, team, date, time) {
      pendingModalLock = { slotId, team, date, time };
      const mhr = MHR_TEAM_DATA[team];
      document.getElementById('modalOpponentName').innerText = `${team} (MHR: ${mhr ? mhr.rating : 'N/A'})`;
      document.getElementById('modalSlotTime').innerText = `${date} @ ${time}`;
      document.getElementById('modalMHRRatingSpread').innerText = mhr ? `Rating Spread &Delta;: ${mhr.diff >= 0 ? '+' + mhr.diff : mhr.diff}` : 'Custom Matchup';
      document.getElementById('proposalModal').classList.remove('hidden');
    }

    function closeProposalModal() {
      document.getElementById('proposalModal').classList.add('hidden');
      pendingModalLock = null;
    }

    function confirmProposalAndLock() {
      if (!pendingModalLock) return;
      const { slotId, team } = pendingModalLock;
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (slot) {
        slot.opponent = team;
        slot.status = 'booked';
      }
      closeProposalModal();
      renderSlots();
      selectSlot(slotId);
      renderWorkingScheduleTable();
      showToast(`Locked ${team} into Slot #${slotId} & Working Schedule!`);
    }

    // MHR Dossier Modal
    function openMHRDossier(teamName) {
      const mhr = MHR_TEAM_DATA[teamName];
      if (!mhr) return;

      document.getElementById('dossierTeamName').innerText = teamName;
      document.getElementById('dossierRating').innerText = mhr.rating;
      document.getElementById('dossierRank').innerText = mhr.rank;
      document.getElementById('dossierDelta').innerText = mhr.diff >= 0 ? `+${mhr.diff}` : `${mhr.diff}`;
      document.getElementById('dossierRecord').innerText = `${mhr.record} (${mhr.stateRank})`;
      document.getElementById('dossierSOS').innerText = `${mhr.sos} Rating`;
      document.getElementById('dossierAGD').innerText = `${mhr.agd} Goals/Game`;

      const parityClass = Math.abs(mhr.diff) <= 1.0 
        ? "5-Star Elite Parity Matchup" 
        : (Math.abs(mhr.diff) <= 2.5 ? "4-Star Competitive Matchup" : "3-Star Developmental Game");
      document.getElementById('dossierParityClass').innerText = parityClass;

      document.getElementById('mhrDossierModal').classList.remove('hidden');
    }

    function closeMHRDossierModal() {
      document.getElementById('mhrDossierModal').classList.add('hidden');
    }

    // MHR Leaderboard Modal
    function openMHRLeaderboardModal() {
      document.getElementById('mhrLeaderboardModal').classList.remove('hidden');
    }
    function closeMHRLeaderboardModal() {
      document.getElementById('mhrLeaderboardModal').classList.add('hidden');
    }

    function renderMHRLeaderboardTable() {
      const tbody = document.getElementById('mhrLeaderboardTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      // Sort teams by rating descending
      const sortedTeams = Object.keys(MHR_TEAM_DATA).sort((a, b) => MHR_TEAM_DATA[b].rating - MHR_TEAM_DATA[a].rating);

      sortedTeams.forEach(team => {
        const data = MHR_TEAM_DATA[team];
        const diffText = data.diff >= 0 ? `+${data.diff}` : `${data.diff}`;
        const isCrimsonNear = Math.abs(data.diff) <= 2.0;

        const tr = document.createElement('tr');
        tr.className = "hover:bg-amber-50/40 border-b border-slate-100 transition";
        tr.innerHTML = `
          <td class="p-2.5 font-bold text-slate-900">${data.rank}</td>
          <td class="p-2.5 font-bold text-slate-800 cursor-pointer hover:text-indigo-600" onclick="openMHRDossier('${team}')">${team}</td>
          <td class="p-2.5 text-center font-extrabold text-amber-800 bg-amber-50/80 rounded">${data.rating}</td>
          <td class="p-2.5 text-center text-slate-700 font-semibold">${data.record}</td>
          <td class="p-2.5 text-center text-slate-600">${data.agd}</td>
          <td class="p-2.5 text-center text-slate-600">${data.sos}</td>
          <td class="p-2.5 text-right font-bold ${isCrimsonNear ? 'text-emerald-600' : 'text-slate-500'}">${diffText}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function exportWorkingScheduleCSV() {
      let csv = "Slot,Format,Date,Time,Location,Opponent,MHR Rating,Parity Delta,Status\n";
      CRIMSON_SLOTS.forEach(s => {
        const mhr = MHR_TEAM_DATA[s.opponent];
        const rating = mhr ? mhr.rating : "N/A";
        const diff = mhr ? mhr.diff : "N/A";
        csv += `"${s.id}","${s.format}","${s.displayDate}","${s.time}","${s.rink}","${s.opponent}","${rating}","${diff}","${s.status}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `Crimson_2014_Working_Schedule_MHR_2026-2027.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast("Working Schedule exported with MHR parity data!");
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = msg;
      toast.classList.remove('translate-y-24');
      setTimeout(() => {
        toast.classList.add('translate-y-24');
      }, 3200);
    }

    function renderMasterScheduleTable() {
      const query = (document.getElementById('masterSearchInput')?.value || '').toLowerCase();
      const tbody = document.getElementById('masterTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const filtered = EHF_MASTER_GAMES.filter(g => 
        g.visitor.toLowerCase().includes(query) ||
        g.home.toLowerCase().includes(query) ||
        g.loc.toLowerCase().includes(query) ||
        g.date.toLowerCase().includes(query)
      );

      document.getElementById('masterCountBadge').innerText = `Showing ${filtered.length} of ${EHF_MASTER_GAMES.length} games`;

      filtered.forEach((game, index) => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-indigo-50/40 border-b border-slate-100 transition";
        tr.innerHTML = `
          <td class="p-2.5 text-slate-400 font-mono font-medium">${index + 1}</td>
          <td class="p-2.5 font-bold text-slate-800 whitespace-nowrap">${game.date}</td>
          <td class="p-2.5 text-indigo-700 font-bold whitespace-nowrap">${game.time}</td>
          <td class="p-2.5 text-slate-800 font-medium">${game.visitor}</td>
          <td class="p-2.5 text-slate-800 font-medium">${game.home}</td>
          <td class="p-2.5 text-slate-500">${game.loc}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function openBusinessCaseModal() { document.getElementById('businessCaseModal').classList.remove('hidden'); }
    function closeBusinessCaseModal() { document.getElementById('businessCaseModal').classList.add('hidden'); }
    function openMasterScheduleModal() { document.getElementById('masterScheduleModal').classList.remove('hidden'); renderMasterScheduleTable(); }
    function closeMasterScheduleModal() { document.getElementById('masterScheduleModal').classList.add('hidden'); }

    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
