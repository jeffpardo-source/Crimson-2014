      4: { open: ["Bulldogs Hockey Club", "South Shore Kings"], flexible: [], conflicted: ["Minuteman Flames Hogan", "NorthStars - Giombetti", "IHC West 2014 - Warilla", "Bay State Breakers 2014", "Boston Jr. Terriers (Red)- Kelleher", "Top Gun - Hayes", "Seacoast Spartans", "CJR 2014"] },
      5: { open: ["Bay State Breakers 2014", "Top Gun - Hayes"], flexible: [], conflicted: ["Minuteman Flames Hogan", "NorthStars - Giombetti", "Bulldogs Hockey Club", "IHC West 2014 - Warilla", "Boston Jr. Terriers (Red)- Kelleher", "South Shore Kings", "Seacoast Spartans", "CJR 2014"] },
      6: { 
