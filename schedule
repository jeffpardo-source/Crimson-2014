<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PuckMatch AI • Youth Hockey Scheduling & MHR Intelligence Platform</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- Top Navbar -->
  <header class="border-b border-slate-200 bg-white/90 backdrop-blur sticky top-0 z-50 px-6 py-3.5 flex items-center justify-between shadow-xs">
    <div class="flex items-center gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-600 via-rose-500 to-indigo-600 flex items-center justify-center shadow-md shadow-rose-200">
        <i data-lucide="shield" class="w-5 h-5 text-white"></i>
      </div>
      <div>
        <div class="flex items-center gap-2.5">
          <span class="font-extrabold text-lg tracking-tight text-slate-900">PuckMatch <span class="text-indigo-600">AI</span></span>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200">EHF 2014 Platinum</span>
          <span class="text-[10px] uppercase font-extrabold tracking-wider px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1">
            <i data-lucide="award" class="w-3 h-3 text-amber-600"></i> MHR Verified
          </span>
        </div>
        <p class="text-xs text-slate-500 font-medium">Algorithmic Matchmaking, Schedule Manager & MYHockey Rankings Intelligence</p>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-bold">
      <button onclick="switchView('matchmaker')" id="navMatchmaker" class="nav-tab active flex items-center gap-2 px-4 py-2 rounded-lg bg-white text-indigo-700 shadow-xs transition">
        <i data-lucide="sparkles" class="w-4 h-4 text-indigo-600"></i> Opponent Matchmaker
      </button>
      <button onclick="switchView('workingSchedule')" id="navWorkingSchedule" class="nav-tab flex items-center gap-2 px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition">
        <i data-lucide="calendar-check" class="w-4 h-4 text-slate-500"></i> Working Schedule
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 font-extrabold" id="tabOpenBadge">10 TBD</span>
      </button>
    </div>

    <!-- Active Team Profile with MHR Rating -->
    <div class="flex items-center gap-4">
      <div class="hidden xl:flex items-center gap-3 text-xs">
        <div class="bg-amber-50 border border-amber-200/80 rounded-xl px-3.5 py-1.5 flex items-center gap-2 shadow-xs">
          <i data-lucide="trending-up" class="w-3.5 h-3.5 text-amber-600"></i>
          <span class="text-slate-500 font-medium">Crimson MHR Rating:</span>
          <span class="font-black text-amber-800">93.85 (#8 US)</span>
        </div>
        <div class="bg-slate-100 border border-slate-200/80 rounded-xl px-3.5 py-1.5 flex items-center gap-2 shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-slate-500 font-medium">Rest Buffer:</span>
          <span class="font-bold text-slate-800">&ge; 4.0 hrs</span>
        </div>
      </div>

      <div class="flex items-center gap-3 pl-2 border-l border-slate-200">
        <div class="text-right hidden sm:block">
          <div class="text-xs font-bold text-slate-900">CRIMSON 2014 AAA</div>
          <div class="text-[11px] text-slate-500 font-medium">Home: Fessenden Rink</div>
        </div>
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-50 to-rose-100 border border-rose-200 flex items-center justify-center font-extrabold text-rose-700 text-sm shadow-xs">
          CR
        </div>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <div class="flex-1 flex overflow-hidden">

    <!-- VIEW 1: OPPONENT MATCHMAKER -->
    <div id="viewMatchmaker" class="flex-1 flex overflow-hidden">
      <!-- Left Sidebar: Crimson Schedule Navigator -->
      <aside class="w-96 border-r border-slate-200 bg-white flex flex-col h-[calc(100vh-65px)]">
        <div class="p-4 border-b border-slate-100 bg-slate-50/50">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-xs font-extrabold text-slate-600 uppercase tracking-wider flex items-center gap-2">
              <i data-lucide="calendar" class="w-4 h-4 text-indigo-600"></i>
              Crimson Ice Slots
            </h2>
            <span class="text-xs font-bold bg-white text-slate-600 px-2.5 py-0.5 rounded-full border border-slate-200 shadow-2xs">13 Total</span>
          </div>
          <div class="flex gap-1.5 p-1 bg-slate-200/60 rounded-xl text-xs">
            <button onclick="filterSlots('all')" class="filter-btn active flex-1 py-1.5 px-2 rounded-lg bg-white text-indigo-700 font-bold text-center shadow-xs transition" data-filter="all">All</button>
            <button onclick="filterSlots('tbd')" class="filter-btn flex-1 py-1.5 px-2 rounded-lg text-slate-600 hover:text-slate-900 font-semibold text-center transition" data-filter="tbd">TBD (<span id="countFilterTBD">10</span>)</button>
            <button onclick="filterSlots('booked')" class="filter-btn flex-1 py-1.5 px-2 rounded-lg text-slate-600 hover:text-slate-900 font-semibold text-center transition" data-filter="booked">Locked (<span id="countFilterLocked">3</span>)</button>
          </div>
        </div>

        <!-- Slots List Container -->
        <div class="flex-1 overflow-y-auto custom-scrollbar p-3.5 space-y-2.5 bg-slate-50/30" id="slotList"></div>
      </aside>

      <!-- Center & Right: Matchmaking Engine -->
      <main class="flex-1 flex flex-col bg-slate-100/60 overflow-y-auto custom-scrollbar">
        
        <!-- Slot Banner / Active Header -->
        <div class="p-6 border-b border-slate-200 bg-white flex flex-wrap items-center justify-between gap-4 shadow-xs">
          <div>
            <div class="flex items-center gap-2.5 mb-1.5">
              <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200" id="activeSlotBadge">Slot #1 Selected</span>
              <span class="text-xs text-slate-500 font-semibold" id="activeSlotDate">Sat, Sep 19, 2026</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-2" id="activeSlotTitle">
              8:20 AM - 9:10 AM @ Fessenden Ice Rink
            </h1>
          </div>

          <div class="flex items-center gap-2.5">
            <button onclick="openMHRLeaderboardModal()" class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-xs font-bold text-amber-800 border border-amber-200 shadow-xs transition">
              <i data-lucide="award" class="w-4 h-4 text-amber-600"></i>
              MHR Division Standings
            </button>
            <button onclick="openBusinessCaseModal()" class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-xs font-bold text-slate-700 border border-slate-200 shadow-xs transition">
              <i data-lucide="trending-up" class="w-4 h-4 text-emerald-600"></i>
              Business Case
            </button>
            <button onclick="openMasterScheduleModal()" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-xs font-bold text-white shadow-md shadow-indigo-200 transition">
              <i data-lucide="database" class="w-4 h-4"></i>
              Master Schedule (180)
            </button>
          </div>
        </div>

        <!-- Algorithmic Engine Content -->
        <div class="p-6 space-y-6 flex-1 max-w-7xl w-full mx-auto">
          
          <!-- Algorithm Insights Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white border border-slate-200/90 p-4.5 rounded-2xl flex items-start gap-4 shadow-xs">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center shrink-0">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-500">Fully Available Opponents</div>
                <div class="text-2xl font-black text-slate-900 mt-0.5" id="countFullyOpen">0</div>
                <div class="text-[11px] text-slate-500 font-medium mt-0.5">Zero games scheduled all day</div>
              </div>
            </div>

            <div class="bg-white border border-slate-200/90 p-4.5 rounded-2xl flex items-start gap-4 shadow-xs">
              <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center shrink-0">
                <i data-lucide="clock" class="w-5 h-5 text-amber-600"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-500">Flexible Same-Day Teams</div>
                <div class="text-2xl font-black text-slate-900 mt-0.5" id="countFlexible">0</div>
                <div class="text-[11px] text-slate-500 font-medium mt-0.5">&ge; 4.0h rest & travel buffer</div>
              </div>
            </div>

            <div class="bg-white border border-slate-200/90 p-4.5 rounded-2xl flex items-start gap-4 shadow-xs">
              <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center shrink-0">
                <i data-lucide="alert-octagon" class="w-5 h-5 text-rose-600"></i>
              </div>
              <div>
                <div class="text-xs font-bold text-slate-500">Conflicted Opponents</div>
                <div class="text-2xl font-black text-slate-900 mt-0.5" id="countConflicted">10</div>
                <div class="text-[11px] text-slate-500 font-medium mt-0.5">Active conflict or &lt;4h rest</div>
              </div>
            </div>
          </div>

          <!-- Matching Opponents Section with MHR Parity Badges -->
          <div>
            <div class="flex flex-wrap items-center justify-between gap-3 mb-3.5">
              <div>
                <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                  <i data-lucide="sparkles" class="w-4 h-4 text-indigo-600"></i>
                  Ranked Feasible Opponent Matches (MHR Integrated)
                </h3>
                <p class="text-xs text-slate-500">Prioritized by MYHockey Rankings rating closeness and rest buffers</p>
              </div>

              <!-- MHR Parity Filter Chips -->
              <div class="flex items-center gap-1.5 bg-white p-1 rounded-xl border border-slate-200 text-xs">
                <span class="text-[11px] text-slate-400 font-semibold px-2">Parity Filter:</span>
                <button onclick="setParityFilter('all')" class="parity-btn active px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 font-bold" data-parity="all">All</button>
                <button onclick="setParityFilter('tight')" class="parity-btn px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 font-medium" data-parity="tight">Tight (&Delta; &lt; 2.0)</button>
                <button onclick="setParityFilter('moderate')" class="parity-btn px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 font-medium" data-parity="moderate">Moderate (&Delta; 2.0-4.0)</button>
              </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="opponentCards"></div>
          </div>

          <!-- League Conflict & MHR Rating Matrix -->
          <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-xs">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h4 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                  <i data-lucide="activity" class="w-4 h-4 text-indigo-600"></i>
                  Division Matrix & MHR Rating Comparison (<span id="heatmapDate" class="text-indigo-600">Sep 19, 2026</span>)
                </h4>
                <p class="text-xs text-slate-500">Real-time status and MHR differentials for all 10 teams in the 2014 Platinum Division</p>
              </div>
              <span class="text-xs bg-slate-100 text-slate-700 font-bold px-3 py-1 rounded-full border border-slate-200">10 Teams Monitored</span>
            </div>

            <div class="overflow-x-auto rounded-xl border border-slate-100">
              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="border-b border-slate-200 text-slate-500 font-bold bg-slate-50">
                    <th class="py-3 px-4">Team Name</th>
                    <th class="py-3 px-4">MHR Rating & Rank</th>
                    <th class="py-3 px-4">Parity &Delta; (vs Crimson)</th>
                    <th class="py-3 px-4">Date Availability</th>
                    <th class="py-3 px-4">Buffer / Rest Status</th>
                    <th class="py-3 px-4 text-right">Quick Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white" id="matrixTableBody"></tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- VIEW 2: WORKING SCHEDULE EDITOR (CRIMSON 2014 AAA 26/27) -->
    <div id="viewWorkingSchedule" class="hidden flex-1 flex flex-col bg-slate-100/60 overflow-y-auto custom-scrollbar">
      <div class="p-6 border-b border-slate-200 bg-white shadow-xs">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2.5 mb-1">
              <span class="text-xs font-extrabold px-3 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200">CRIMSON 2014 AAA 26/27</span>
              <span class="text-xs text-slate-500 font-medium">Master Working Schedule</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900">Dynamic Season Working Schedule</h1>
            <p class="text-xs text-slate-500 mt-0.5">Edit opponents, assign Home/Away status, and review MHR Match Quality scores.</p>
          </div>

          <div class="flex items-center gap-3">
            <button onclick="exportWorkingScheduleCSV()" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-xs font-bold text-slate-700 border border-slate-200 shadow-xs transition">
              <i data-lucide="download" class="w-4 h-4 text-indigo-600"></i>
              Export Schedule (CSV)
            </button>
            <button onclick="switchView('matchmaker')" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-xs font-bold text-white shadow-md shadow-indigo-200 transition">
              <i data-lucide="sparkles" class="w-4 h-4"></i>
              Open Opponent Matchmaker
            </button>
          </div>
        </div>
      </div>

      <!-- Working Schedule Table Grid -->
      <div class="p-6 max-w-7xl w-full mx-auto flex-1 space-y-6">
        
        <!-- Summary Stats Card -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <div class="text-xs font-bold text-slate-500">Total Season Slots</div>
              <div class="text-2xl font-black text-slate-900 mt-0.5">13 Games</div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600">
              <i data-lucide="calendar" class="w-5 h-5"></i>
            </div>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <div class="text-xs font-bold text-slate-500">Locked / Confirmed</div>
              <div class="text-2xl font-black text-emerald-600 mt-0.5" id="summaryConfirmed">3 Games</div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600">
              <i data-lucide="check-circle" class="w-5 h-5"></i>
            </div>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <div class="text-xs font-bold text-slate-500">Pending TBD Slots</div>
              <div class="text-2xl font-black text-rose-600 mt-0.5" id="summaryPending">10 Slots</div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center text-rose-600">
              <i data-lucide="alert-circle" class="w-5 h-5"></i>
            </div>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <div class="text-xs font-bold text-slate-500">Avg Opponent MHR</div>
              <div class="text-xl font-black text-amber-700 mt-1">92.40 Rating</div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600">
              <i data-lucide="award" class="w-5 h-5"></i>
            </div>
          </div>
        </div>

        <!-- Interactive Schedule Table with MHR columns -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
          <div class="p-4 border-b border-slate-100 bg-slate-50/70 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
              <i data-lucide="table" class="w-4 h-4 text-indigo-600"></i>
              Season Ice Slots & Opponent Assignments
            </h3>
            <span class="text-xs text-slate-500 font-medium">Select opponent from dropdown or lock via matchmaker</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="bg-slate-100/80 text-slate-600 border-b border-slate-200 font-extrabold uppercase tracking-wider text-[11px]">
                  <th class="py-3 px-4">Slot #</th>
                  <th class="py-3 px-4">Format</th>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4">Time</th>
                  <th class="py-3 px-4">Location / Venue</th>
                  <th class="py-3 px-4 min-w-[230px]">Locked Opponent</th>
                  <th class="py-3 px-4">MHR Rating & Parity</th>
                  <th class="py-3 px-4 text-center">Status</th>
                  <th class="py-3 px-4 text-right">Quick Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 bg-white" id="workingScheduleTableBody"></tbody>
            </table>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- MHR TEAM INTELLIGENCE DOSSIER MODAL -->
  <div id="mhrDossierModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600">
            <i data-lucide="award" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-lg text-slate-900" id="dossierTeamName">Team Dossier</h3>
            <p class="text-xs text-slate-500 font-medium">MYHockeyRankings.com Profile & Intelligence</p>
          </div>
        </div>
        <button onclick="closeMHRDossierModal()" class="text-slate-400 hover:text-slate-700 transition">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="grid grid-cols-3 gap-3 text-center">
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/80">
          <div class="text-[11px] text-slate-500 font-medium">MHR Rating</div>
          <div class="text-lg font-black text-amber-700 mt-0.5" id="dossierRating">94.10</div>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/80">
          <div class="text-[11px] text-slate-500 font-medium">National Rank</div>
          <div class="text-lg font-black text-slate-900 mt-0.5" id="dossierRank">#6 US</div>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/80">
          <div class="text-[11px] text-slate-500 font-medium">Parity Delta</div>
          <div class="text-lg font-black text-emerald-600 mt-0.5" id="dossierDelta">+0.25</div>
        </div>
      </div>

      <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/80 space-y-2.5 text-xs">
        <div class="flex justify-between"><span class="text-slate-500 font-medium">Season Record:</span> <span class="font-bold text-slate-900" id="dossierRecord">18-4-2 (81.8% PTS)</span></div>
        <div class="flex justify-between"><span class="text-slate-500 font-medium">Strength of Schedule (SOS):</span> <span class="font-bold text-slate-800" id="dossierSOS">92.45 Rating</span></div>
        <div class="flex justify-between"><span class="text-slate-500 font-medium">Avg Goal Differential (AGD):</span> <span class="font-bold text-slate-800" id="dossierAGD">+2.15 Goals/Game</span></div>
        <div class="flex justify-between border-t border-slate-200 pt-2"><span class="text-slate-500 font-medium">Parity Quality:</span> <span class="text-emerald-700 font-bold" id="dossierParityClass">5-Star Elite Development Matchup</span></div>
      </div>

      <button onclick="closeMHRDossierModal()" class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-xs font-bold text-white transition">
        Close Dossier
      </button>
    </div>
  </div>

  <!-- MHR DIVISION LEADERBOARD MODAL -->
  <div id="mhrLeaderboardModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-2xl animate-in fade-in zoom-in-95 duration-200">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600">
            <i data-lucide="award" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-base text-slate-900">MYHockey Rankings • 2014 Platinum Standings</h3>
            <p class="text-xs text-slate-500">Live Rating & Strength Indexes from MYHockeyRankings.com</p>
