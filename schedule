        flexible: [
          { team: "South Shore Kings", priorGame: "9:00 AM @ Hobomock 2", restHours: "5.5h buffer" },
          { team: "Bay State Breakers 2014", priorGame: "9:00 AM @ Hobomock 2", restHours: "5.5h buffer" }
        ], 
        conflicted: ["Minuteman Flames Hogan", "NorthStars - Giombetti", "Bulldogs Hockey Club", "Seacoast Spartans"] 
      },
      7: { open: [...DIVISION_TEAMS], flexible: [], conflicted: [] }, // Halloween open weekend
      8: { open: ["IHC West 2014 - Warilla", "Bay State Breakers 2014", "Top Gun - Hayes", "CJR 2014"], flexible: [], conflicted: ["Minuteman Flames Hogan", "NorthStars - Giombetti", "Bulldogs Hockey Club", "Boston Jr. Terriers (Red)- Kelleher", "South Shore Kings", "Seacoast Spartans"] },
      9: { open: ["NorthStars - Giombetti", "Bulldogs Hockey Club", "IHC West 2014 - Warilla", "Bay State Breakers 2014", "Boston Jr. Terriers (Red)- Kelleher", "Top Gun - Hayes", "Seacoast Spartans", "CJR 2014"], flexible: [], conflicted: ["Minuteman Flames Hogan", "South Shore Kings"] },
      10: { open: ["NorthStars - Giombetti", "Bulldogs Hockey Club", "Top Gun - Hayes", "South Shore Kings"], flexible: [], conflicted: ["Minuteman Flames Hogan", "IHC West 2014 - Warilla", "Bay State Breakers 2014", "Boston Jr. Terriers (Red)- Kelleher", "Seacoast Spartans", "CJR 2014"] }
    };

    // Master EHF Sample Data for Matrix/Modal
    const EHF_MASTER_GAMES = [
      { date: "Sep 19, 2026", time: "10:35 AM", visitor: "IHC West 2014 - Warilla", home: "Top Gun - Hayes", loc: "Salem Ice Center" },
      { date: "Sep 19, 2026", time: "11:00 AM", visitor: "Minuteman Flames Hogan", home: "CJR 2014", loc: "Edward L Bennett Rink" },
      { date: "Sep 19, 2026", time: "12:00 PM", visitor: "Bay State Breakers 2014", home: "South Shore Kings", loc: "Foxboro Sports Center" },
      { date: "Sep 19, 2026", time: "12:45 PM", visitor: "Boston Jr. Terriers (Red)- Kelleher", home: "NorthStars - Giombetti", loc: "NorthStar Ice Sports" },
      { date: "Sep 19, 2026", time: "1:45 PM", visitor: "Minuteman Flames Hogan", home: "CJR 2014", loc: "Edward L Bennett Rink" },
      { date: "Sep 19, 2026", time: "3:40 PM", visitor: "Bulldogs Hockey Club", home: "Seacoast Spartans", loc: "Rinks at Exeter 1" },
      { date: "Sep 26, 2026", time: "11:00 AM", visitor: "Top Gun - Hayes", home: "CJR 2014", loc: "Edward L Bennett Rink" },
      { date: "Sep 26, 2026", time: "1:40 PM", visitor: "South Shore Kings", home: "IHC West 2014 - Warilla", loc: "Skate 3 Red" },
      { date: "Sep 26, 2026", time: "2:50 PM", visitor: "Bulldogs Hockey Club", home: "Bay State Breakers 2014", loc: "Bog 2" },
      { date: "Sep 26, 2026", time: "7:40 PM", visitor: "Seacoast Spartans", home: "Boston Jr. Terriers (Red)- Kelleher", loc: "Canton Sportsplex" },
      { date: "Oct 25, 2026", time: "9:00 AM", visitor: "South Shore Kings", home: "Bay State Breakers 2014", loc: "Hobomock 2" },
      { date: "Oct 25, 2026", time: "12:25 PM", visitor: "Seacoast Spartans", home: "Bulldogs Hockey Club", loc: "Janas Memorial" },
      { date: "Oct 25, 2026", time: "5:05 PM", visitor: "Minuteman Flames Hogan", home: "NorthStars - Giombetti", loc: "NorthStar Ice Sports" }
    ];

    let currentSelectedSlotId = 2; // Default to Slot #2 (Sep 26)
    let currentFilter = 'all';

    function initApp() {
      renderSlots();
      selectSlot(currentSelectedSlotId);
      renderMasterScheduleTable();
      lucide.createIcons();
    }

    function filterSlots(type) {
      currentFilter = type;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        if (btn.dataset.filter === type) {
          btn.classList.add('bg-indigo-600', 'text-white');
          btn.classList.remove('bg-slate-800', 'text-slate-300');
        } else {
          btn.classList.remove('bg-indigo-600', 'text-white');
          btn.classList.add('bg-slate-800', 'text-slate-300');
        }
      });
      renderSlots();
    }

    function renderSlots() {
      const container = document.getElementById('slotList');
      container.innerHTML = '';

      const filtered = CRIMSON_SLOTS.filter(s => {
        if (currentFilter === 'tbd') return s.status === 'open';
        if (currentFilter === 'booked') return s.status === 'booked';
        return true;
      });

      filtered.forEach(slot => {
        const isSelected = slot.id === currentSelectedSlotId;
        const avail = AVAILABILITY_DATA[slot.id] || { open: [], flexible: [] };
        const totalMatches = avail.open.length + avail.flexible.length;

        const card = document.createElement('div');
        card.className = `p-3 rounded-xl border transition cursor-pointer ${
          isSelected 
            ? 'bg-indigo-950/40 border-indigo-500 shadow-md shadow-indigo-950/50' 
            : 'bg-slate-900/60 border-slate-800/80 hover:border-slate-700 hover:bg-slate-900'
        }`;
        card.onclick = () => selectSlot(slot.id);

        card.innerHTML = `
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[11px] font-bold ${isSelected ? 'text-indigo-400' : 'text-slate-400'}">Slot #${slot.id}</span>
            ${slot.status === 'open' 
              ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">${totalMatches} Matches</span>`
              : `<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700">Booked</span>`
            }
          </div>
          <div class="text-xs font-bold text-white mb-0.5">${slot.displayDate}</div>
          <div class="text-[11px] text-slate-300 flex items-center gap-1.5 mb-1.5">
            <i data-lucide="clock" class="w-3 h-3 text-slate-400"></i> ${slot.time}
          </div>
          <div class="text-[11px] text-slate-400 flex items-center justify-between border-t border-slate-800/60 pt-1.5 mt-1">
            <span>${slot.team === 'TBD' ? '<span class="text-amber-400 font-medium">Needs Opponent</span>' : `<span class="text-slate-300 font-medium">${slot.team}</span>`}</span>
            <span class="text-[10px] text-slate-500">${slot.rink.split(' ')[0]}</span>
          </div>
        `;
        container.appendChild(card);
      });
      lucide.createIcons();
    }

    function selectSlot(slotId) {
      currentSelectedSlotId = slotId;
      renderSlots();

      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;

      document.getElementById('activeSlotBadge').innerText = `Slot #${slot.id} Selected`;
      document.getElementById('activeSlotDate').innerText = slot.displayDate;
      document.getElementById('activeSlotTitle').innerHTML = `
        ${slot.time} @ ${slot.rink}
        ${slot.status === 'booked' ? '<span class="text-xs font-semibold px-2 py-1 rounded bg-slate-800 text-slate-300 ml-2">Booked: ' + slot.team + '</span>' : ''}
      `;
      document.getElementById('heatmapDate').innerText = slot.displayDate;

      const avail = AVAILABILITY_DATA[slot.id] || { open: [], flexible: [], conflicted: DIVISION_TEAMS };
      
      document.getElementById('countFullyOpen').innerText = avail.open.length;
      document.getElementById('countFlexible').innerText = avail.flexible.length;
      document.getElementById('countConflicted').innerText = avail.conflicted.length;

      renderOpponentCards(avail, slot);
      renderConflictMatrix(slot, avail);
    }

    function renderOpponentCards(avail, slot) {
      const container = document.getElementById('opponentCards');
      container.innerHTML = '';

      if (avail.open.length === 0 && avail.flexible.length === 0) {
        container.innerHTML = `
          <div class="col-span-2 bg-slate-900/40 border border-slate-800 rounded-xl p-8 text-center">
            <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center mx-auto mb-3 text-slate-400">
              <i data-lucide="calendar-x" class="w-6 h-6"></i>
            </div>
            <h4 class="text-sm font-bold text-white">No Fully Available Opponents</h4>
            <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">All 10 EHF Platinum teams have existing league commitments on this date. Consider offering a flexible swap or booking an exhibition opponent.</p>
          </div>
        `;
        lucide.createIcons();
        return;
      }

      // 1. Fully Available Opponents
      avail.open.forEach(team => {
        const card = document.createElement('div');
        card.className = "bg-slate-900/80 border border-emerald-500/30 rounded-xl p-4 flex flex-col justify-between hover:border-emerald-500/60 transition shadow-lg shadow-emerald-950/20";
        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1">
                <i data-lucide="check" class="w-3 h-3"></i> 100% Fully Available
              </span>
              <span class="text-xs font-semibold text-slate-400">Rank #1 Match</span>
            </div>
            <h4 class="text-sm font-bold text-white mb-1">${team}</h4>
            <p class="text-xs text-slate-400 mb-3">Zero EHF games scheduled all day. Optimal competitive parity match.</p>
          </div>
          <div class="pt-3 border-t border-slate-800 flex items-center justify-between">
            <span class="text-[11px] text-slate-400 flex items-center gap-1"><i data-lucide="map-pin" class="w-3 h-3 text-indigo-400"></i> Fessenden Ice Rink</span>
            <button onclick="openProposalModal('${team}', '${slot.displayDate}', '${slot.time}')" class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-xs font-bold text-white transition flex items-center gap-1.5">
              <i data-lucide="send" class="w-3 h-3"></i> Send Invite
            </button>
          </div>
        `;
        container.appendChild(card);
      });

      // 2. Flexible Same-Day Opponents (4h buffer rule)
      avail.flexible.forEach(item => {
        const card = document.createElement('div');
        card.className = "bg-slate-900/80 border border-amber-500/30 rounded-xl p-4 flex flex-col justify-between hover:border-amber-500/60 transition shadow-lg shadow-amber-950/20";
        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center gap-1">
                <i data-lucide="clock" class="w-3 h-3"></i> Same-Day Feasible (&ge;4h)
              </span>
              <span class="text-xs font-semibold text-amber-400">${item.restHours}</span>
            </div>
            <h4 class="text-sm font-bold text-white mb-1">${item.team}</h4>
            <p class="text-xs text-slate-400 mb-1.5">Plays prior game: <span class="text-slate-300 font-medium">${item.priorGame}</span></p>
            <p class="text-[11px] text-emerald-400 flex items-center gap-1"><i data-lucide="shield-check" class="w-3 h-3"></i> Complies with league safety & travel buffer</p>
          </div>
          <div class="pt-3 border-t border-slate-800 flex items-center justify-between mt-3">
            <span class="text-[11px] text-slate-400">Rest gap: ${item.restHours}</span>
            <button onclick="openProposalModal('${item.team}', '${slot.displayDate}', '${slot.time}')" class="px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-xs font-bold text-slate-950 transition flex items-center gap-1.5">
              <i data-lucide="send" class="w-3 h-3"></i> Propose Match
            </button>
          </div>
        `;
        container.appendChild(card);
      });

      lucide.createIcons();
    }

    function renderConflictMatrix(slot, avail) {
      const tbody = document.getElementById('matrixTableBody');
      tbody.innerHTML = '';

      DIVISION_TEAMS.forEach(team => {
        const isOpen = avail.open.includes(team);
        const flexItem = avail.flexible.find(f => f.team === team);
        const isConflicted = avail.conflicted.includes(team);

        let statusBadge = '';
        let scheduledText = 'No games scheduled';
        let bufferText = '<span class="text-emerald-400 font-semibold">&ge; 4.0h (100% Free)</span>';
        let actionBtn = `<button onclick="openProposalModal('${team}', '${slot.displayDate}', '${slot.time}')" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300">Invite</button>`;

        if (isOpen) {
          statusBadge = '<span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold border border-emerald-500/30">Fully Available</span>';
        } else if (flexItem) {
          statusBadge = '<span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-bold border border-amber-500/30">Flexible (&ge;4h)</span>';
          scheduledText = flexItem.priorGame;
          bufferText = `<span class="text-amber-300 font-semibold">${flexItem.restHours}</span>`;
          actionBtn = `<button onclick="openProposalModal('${team}', '${slot.displayDate}', '${slot.time}')" class="text-xs font-semibold text-amber-400 hover:text-amber-300">Propose</button>`;
        } else {
          statusBadge = '<span class="px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-400 text-[10px] font-bold border border-rose-500/30">Conflicted</span>';
          scheduledText = 'Active EHF Platinum Game';
          bufferText = '<span class="text-rose-400 font-semibold">&lt; 4.0h / Slot Conflict</span>';
          actionBtn = `<span class="text-slate-600 text-xs">Locked</span>`;
        }

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-900/40 transition";
        tr.innerHTML = `
          <td class="py-2.5 px-3 font-medium text-slate-200">${team}</td>
          <td class="py-2.5 px-3">${statusBadge}</td>
          <td class="py-2.5 px-3 text-slate-400">${scheduledText}</td>
          <td class="py-2.5 px-3">${bufferText}</td>
          <td class="py-2.5 px-3 text-right">${actionBtn}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function renderMasterScheduleTable() {
      const query = (document.getElementById('masterSearchInput')?.value || '').toLowerCase();
      const tbody = document.getElementById('masterTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const filtered = EHF_MASTER_GAMES.filter(g => 
        g.visitor.toLowerCase().includes(query) ||
        g.home.toLowerCase().includes(query) ||
        g.loc.toLowerCase().includes(query) ||
        g.date.toLowerCase().includes(query)
      );

      filtered.forEach(game => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-950/60 border-b border-slate-800/40";
        tr.innerHTML = `
          <td class="p-2 font-medium text-slate-300">${game.date}</td>
          <td class="p-2 text-slate-400 font-mono">${game.time}</td>
          <td class="p-2 text-slate-200">${game.visitor}</td>
          <td class="p-2 text-slate-200">${game.home}</td>
          <td class="p-2 text-slate-400">${game.loc}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Modal Control Functions
    function openProposalModal(team, date, time) {
      document.getElementById('modalOpponentName').innerText = team;
      document.getElementById('modalSlotTime').innerText = `${date} @ ${time}`;
      document.getElementById('proposalModal').classList.remove('hidden');
    }
    function closeProposalModal() {
      document.getElementById('proposalModal').classList.add('hidden');
    }
    function confirmProposalSend() {
      closeProposalModal();
      const toast = document.getElementById('toast');
      toast.classList.remove('translate-y-24');
      setTimeout(() => {
        toast.classList.add('translate-y-24');
      }, 3500);
    }

    function openBusinessCaseModal() {
      document.getElementById('businessCaseModal').classList.remove('hidden');
    }
    function closeBusinessCaseModal() {
      document.getElementById('businessCaseModal').classList.add('hidden');
    }

    function openMasterScheduleModal() {
      document.getElementById('masterScheduleModal').classList.remove('hidden');
      renderMasterScheduleTable();
    }
    function closeMasterScheduleModal() {
      document.getElementById('masterScheduleModal').classList.add('hidden');
    }

    // Launch App on load
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
