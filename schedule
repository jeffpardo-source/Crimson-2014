        let actionBtn = `<button onclick="promptLockOpponent(${slot.id}, '${team}', '${slot.displayDate}', '${slot.time}')" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">Lock Match</button>`;

        if (isOpen) {
          statusBadge = '<span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-bold border border-emerald-200">Fully Available</span>';
        } else if (flexItem) {
          statusBadge = '<span class="px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 text-[10px] font-bold border border-amber-200">Flexible (&ge;4h)</span>';
          bufferText = `<span class="text-amber-700 font-bold">${flexItem.restHours}</span>`;
          actionBtn = `<button onclick="promptLockOpponent(${slot.id}, '${team}', '${slot.displayDate}', '${slot.time}')" class="text-xs font-bold text-amber-600 hover:text-amber-800">Lock Match</button>`;
        } else {
          statusBadge = '<span class="px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 text-[10px] font-bold border border-rose-200">Conflicted</span>';
          bufferText = '<span class="text-rose-600 font-semibold">&lt; 4.0h / Conflict</span>';
          actionBtn = `<span class="text-slate-400 text-xs font-medium">Conflict</span>`;
        }

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50/70 transition";
        tr.innerHTML = `
          <td class="py-3 px-4 font-bold text-slate-800">${team}</td>
          <td class="py-3 px-4">
            <span class="font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">${contact ? contact.rating : '86.0'}</span>
            <span class="text-slate-500 font-medium ml-1">EHF Platinum</span>
          </td>
          <td class="py-3 px-4">${statusBadge}</td>
          <td class="py-3 px-4">${bufferText}</td>
          <td class="py-3 px-4">
            ${contact ? `<span class="font-semibold text-slate-700">${contact.coach || 'Listed'}</span> ${contact.coachCell ? `<span class="text-slate-400">(${contact.coachCell})</span>` : ''}` : '-'}
          </td>
          <td class="py-3 px-4 text-right">${actionBtn}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // ==========================================
    // VIEW 2: WORKING SCHEDULE TABLE
    // ==========================================
    function renderWorkingScheduleTable() {
      const tbody = document.getElementById('workingScheduleTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      CRIMSON_SLOTS.forEach(slot => {
        const isLocked = slot.status === 'booked';
        const contact = findContactForTeam(slot.opponent);
        const tr = document.createElement('tr');
        tr.className = `hover:bg-indigo-50/30 transition ${isLocked ? 'bg-emerald-50/20' : ''}`;

        let opponentOptions = `<option value="TBD" ${slot.opponent === 'TBD' ? 'selected' : ''}>-- TBD (Select Opponent) --</option>`;
        
        CONTACTS_DATA.forEach(c => {
          opponentOptions += `<option value="${c.club}" ${slot.opponent === c.club ? 'selected' : ''}>${c.club} (${c.org})</option>`;
        });

        tr.innerHTML = `
          <td class="py-3.5 px-4 font-bold text-slate-900">#${slot.id}</td>
          <td class="py-3.5 px-4">
            <select onchange="updateSlotFormat(${slot.id}, this.value)" class="bg-white border border-slate-200 rounded-lg px-2 py-1 font-bold text-slate-700 focus:outline-none focus:border-indigo-600 shadow-2xs">
              <option value="HOME" ${slot.format === 'HOME' ? 'selected' : ''}>HOME</option>
              <option value="AWAY" ${slot.format === 'AWAY' ? 'selected' : ''}>AWAY</option>
            </select>
          </td>
          <td class="py-3.5 px-4 font-bold text-slate-800">${slot.displayDate}</td>
          <td class="py-3.5 px-4 text-indigo-700 font-bold whitespace-nowrap">${slot.time}</td>
          <td class="py-3.5 px-4">
            <input type="text" value="${slot.rink}" onchange="updateSlotRink(${slot.id}, this.value)" class="bg-transparent border-b border-transparent hover:border-slate-300 focus:border-indigo-600 focus:bg-white px-1 py-0.5 rounded text-slate-700 w-full focus:outline-none transition">
          </td>
          <td class="py-3.5 px-4">
            <select onchange="updateSlotOpponent(${slot.id}, this.value)" class="w-full bg-white border ${isLocked ? 'border-emerald-300 text-emerald-900 font-extrabold bg-emerald-50/50' : 'border-slate-200 text-slate-800 font-medium'} rounded-xl px-3 py-1.5 focus:outline-none focus:border-indigo-600 shadow-2xs transition">
              ${opponentOptions}
            </select>
          </td>
          <td class="py-3.5 px-4">
            ${contact ? `
              <div class="text-xs">
                <span class="font-bold text-slate-800">${contact.coach || contact.manager || 'Listed'}</span>
                ${contact.coachCell ? `<div class="text-[11px] text-indigo-600">${contact.coachCell}</div>` : ''}
              </div>
            ` : '<span class="text-slate-400">-</span>'}
          </td>
          <td class="py-3.5 px-4 text-center">
            ${isLocked 
              ? `<span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold border border-emerald-200 flex items-center gap-1 justify-center"><i data-lucide="check" class="w-3 h-3"></i> Locked</span>`
              : `<span class="px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 text-[10px] font-extrabold border border-rose-200">Open TBD</span>`
            }
          </td>
          <td class="py-3.5 px-4 text-right whitespace-nowrap">
            ${isLocked
              ? `<button onclick="unlockSlot(${slot.id})" class="text-xs font-bold text-rose-600 hover:text-rose-800 transition px-2 py-1 rounded hover:bg-rose-50">Clear / Unlock</button>`
              : `<button onclick="goToMatchmakerForSlot(${slot.id})" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition px-2 py-1 rounded hover:bg-indigo-50 flex items-center gap-1 ml-auto"><i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Find Teams</button>`
            }
          </td>
        `;
        tbody.appendChild(tr);
      });
      updateGlobalCounters();
      lucide.createIcons();
    }

    function updateSlotOpponent(slotId, newOpponent) {
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;
      slot.opponent = newOpponent;
      slot.status = (newOpponent === 'TBD' || newOpponent === '') ? 'open' : 'booked';
      
      saveScheduleState();
      renderWorkingScheduleTable();
      renderSlots();
      selectSlot(currentSelectedSlotId);
      showToast(`Slot #${slotId} updated: ${newOpponent}`);
    }

    function updateSlotFormat(slotId, newFormat) {
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;
      slot.format = newFormat;
      saveScheduleState();
      showToast(`Slot #${slotId} format updated to ${newFormat}`);
    }

    function updateSlotRink(slotId, newRink) {
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;
      slot.rink = newRink;
      saveScheduleState();
      showToast(`Slot #${slotId} venue updated to ${newRink}`);
    }

    function unlockSlot(slotId) {
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (!slot) return;
      slot.opponent = 'TBD';
      slot.status = 'open';

      saveScheduleState();
      renderWorkingScheduleTable();
      renderSlots();
      selectSlot(slotId);
      showToast(`Slot #${slotId} reset to TBD`);
    }

    function goToMatchmakerForSlot(slotId) {
      switchView('matchmaker');
      selectSlot(slotId);
    }

    function promptLockOpponent(slotId, team, date, time) {
      pendingModalLock = { slotId, team, date, time };
      document.getElementById('modalOpponentName').innerText = team;
      document.getElementById('modalSlotTime').innerText = `${date} @ ${time}`;
      document.getElementById('proposalModal').classList.remove('hidden');
    }

    function closeProposalModal() {
      document.getElementById('proposalModal').classList.add('hidden');
      pendingModalLock = null;
    }

    function confirmProposalAndLock() {
      if (!pendingModalLock) return;
      const { slotId, team } = pendingModalLock;
      const slot = CRIMSON_SLOTS.find(s => s.id === slotId);
      if (slot) {
        slot.opponent = team;
        slot.status = 'booked';
      }
      saveScheduleState();
      closeProposalModal();
      renderSlots();
      selectSlot(slotId);
      renderWorkingScheduleTable();
      showToast(`Locked ${team} into Slot #${slotId}!`);
    }

    // ==========================================
    // VIEW 3: CONTACTS DIRECTORY HUB
    // ==========================================
    function renderContactsGrid() {
      const container = document.getElementById('contactsCardsGrid');
      if (!container) return;
      container.innerHTML = '';

      const query = (document.getElementById('contactSearchInput')?.value || '').toLowerCase();
      const orgFilter = document.getElementById('contactOrgFilter')?.value || 'ALL';
      const respFilter = document.getElementById('contactResponsiveFilter')?.value || 'ALL';

      const filtered = CONTACTS_DATA.filter(c => {
        const matchesQuery = 
          c.club.toLowerCase().includes(query) ||
          c.coach.toLowerCase().includes(query) ||
          c.coachEmail.toLowerCase().includes(query) ||
          c.location.toLowerCase().includes(query) ||
          c.manager.toLowerCase().includes(query) ||
          c.notes.toLowerCase().includes(query);

        const matchesOrg = (orgFilter === 'ALL') || c.org.includes(orgFilter);

        let matchesResp = true;
        if (respFilter === 'YES') matchesResp = (c.responsive === 'Yes');
        if (respFilter === 'CURTIS') matchesResp = (c.priority === 'Curtis');
        if (respFilter === 'AYRTON') matchesResp = (c.priority === 'Ayrton');

        return matchesQuery && matchesOrg && matchesResp;
      });

      filtered.forEach((c, index) => {
        const card = document.createElement('div');
        card.className = "bg-white border border-slate-200/90 rounded-2xl p-4.5 flex flex-col justify-between hover:border-indigo-400 transition shadow-xs hover:shadow-md";

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">${c.org || 'Independent'}</span>
              ${c.responsive === 'Yes' 
                ? '<span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center gap-1"><i data-lucide="check" class="w-3 h-3 text-emerald-600"></i> Responsive</span>'
                : (c.priority ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">${c.priority}</span>` : '')
              }
            </div>

            <h4 class="text-sm font-extrabold text-slate-900 mb-1">${c.club}</h4>
            <p class="text-xs text-slate-500 mb-3 flex items-center gap-1.5">
              <i data-lucide="map-pin" class="w-3 h-3 text-slate-400"></i> ${c.location || 'Location Not Specified'}
            </p>

            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/70 text-xs space-y-1.5 mb-3">
              <div class="flex justify-between items-center">
                <span class="text-slate-500 font-medium">Head Coach:</span>
                <span class="font-bold text-slate-800">${c.coach || 'None Listed'}</span>
              </div>
              ${c.coachCell ? `
                <div class="flex justify-between items-center">
                  <span class="text-slate-500 font-medium">Phone:</span>
                  <a href="tel:${c.coachCell}" class="font-bold text-indigo-600 hover:underline flex items-center gap-1"><i data-lucide="phone" class="w-3 h-3"></i> ${c.coachCell}</a>
                </div>
              ` : ''}
              ${c.coachEmail ? `
                <div class="flex justify-between items-center">
                  <span class="text-slate-500 font-medium">Email:</span>
                  <a href="mailto:${c.coachEmail}" class="font-semibold text-indigo-600 hover:underline truncate max-w-[180px]">${c.coachEmail}</a>
                </div>
              ` : ''}
            </div>

            ${c.notes ? `
              <div class="text-[11px] text-slate-600 bg-amber-50/60 border border-amber-200/70 p-2.5 rounded-xl line-clamp-2 mb-3">
                <span class="font-bold text-amber-900">Note:</span> ${c.notes}
              </div>
            ` : ''}
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">${c.rating ? c.rating + ' Rating' : 'MHR'}</span>
            <button onclick="openContactModalByIndex(${index})" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition flex items-center gap-1">
              View Full Profile <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        `;
        container.appendChild(card);
      });
      lucide.createIcons();
    }

    function openContactModalByIndex(index) {
      const c = CONTACTS_DATA[index];
      if (!c) return;

      document.getElementById('modalClubName').innerText = c.club;
      document.getElementById('modalClubOrg').innerText = `${c.org || 'Independent'} • Assigned: ${c.priority || 'General'}`;
      document.getElementById('modalClubLoc').innerText = c.location || 'Location Not Specified';
      document.getElementById('modalClubRating').innerText = c.rating ? `${c.rating} Rating` : 'MHR Tier 1';

      document.getElementById('modalCoachName').innerText = c.coach || 'None Listed';
      document.getElementById('modalCoachEmail').innerHTML = c.coachEmail ? `<a href="mailto:${c.coachEmail}" class="text-indigo-600 underline">${c.coachEmail}</a>` : 'No email';
      document.getElementById('modalCoachCell').innerHTML = c.coachCell ? `<a href="tel:${c.coachCell}" class="text-indigo-600 underline">${c.coachCell}</a>` : 'No cell';

      if (c.asstCoach || c.asstCoachCell || c.asstCoachEmail) {
        document.getElementById('modalAsstCoachSection').classList.remove('hidden');
        document.getElementById('modalAsstCoachName').innerText = c.asstCoach || 'Assistant Coach';
        document.getElementById('modalAsstCoachEmail').innerText = c.asstCoachEmail || '';
        document.getElementById('modalAsstCoachCell').innerText = c.asstCoachCell || '';
      } else {
        document.getElementById('modalAsstCoachSection').classList.add('hidden');
      }

      if (c.manager || c.managerCell || c.managerEmail) {
        document.getElementById('modalManagerSection').classList.remove('hidden');
        document.getElementById('modalManagerName').innerText = c.manager || 'Manager';
        document.getElementById('modalManagerEmail').innerText = c.managerEmail || '';
        document.getElementById('modalManagerCell').innerText = c.managerCell || '';
      } else {
        document.getElementById('modalManagerSection').classList.add('hidden');
      }

      document.getElementById('modalNotesText').innerText = c.notes || 'No outreach notes recorded.';

      if (c.games) {
        document.getElementById('modalGamesSection').classList.remove('hidden');
        document.getElementById('modalGamesText').innerText = c.games;
      } else {
        document.getElementById('modalGamesSection').classList.add('hidden');
      }

      document.getElementById('contactModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeContactModal() {
      document.getElementById('contactModal').classList.add('hidden');
    }

    function exportContactsCSV() {
      let csv = "Club,Org,Rating,Priority,Location,Coach,Coach Email,Coach Cell,Asst Coach,Manager,Responsive,Notes,Games\n";
      CONTACTS_DATA.forEach(c => {
        csv += `"${c.club}","${c.org}","${c.rating}","${c.priority}","${c.location}","${c.coach}","${c.coachEmail}","${c.coachCell}","${c.asstCoach}","${c.manager}","${c.responsive}","${c.notes.replace(/"/g, '""')}","${c.games}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `Youth_Hockey_Contacts_Directory.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast("Contacts exported to CSV!");
    }

    function exportWorkingScheduleCSV() {
      let csv = "Slot,Format,Date,Time,Location,Opponent,Status\n";
      CRIMSON_SLOTS.forEach(s => {
        csv += `"${s.id}","${s.format}","${s.displayDate}","${s.time}","${s.rink}","${s.opponent}","${s.status}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `Crimson_2014_Working_Schedule.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast("Working Schedule exported!");
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = msg;
      toast.classList.remove('translate-y-24');
      setTimeout(() => {
        toast.classList.add('translate-y-24');
      }, 3200);
    }

    function renderMasterScheduleTable() {
      const query = (document.getElementById('masterSearchInput')?.value || '').toLowerCase();
      const tbody = document.getElementById('masterTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      const filtered = EHF_MASTER_GAMES.filter(g => 
        g.visitor.toLowerCase().includes(query) ||
        g.home.toLowerCase().includes(query) ||
        g.loc.toLowerCase().includes(query) ||
        g.date.toLowerCase().includes(query)
      );

      document.getElementById('masterCountBadge').innerText = `Showing ${filtered.length} of ${EHF_MASTER_GAMES.length} games`;

      filtered.forEach((game, index) => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-indigo-50/40 border-b border-slate-100 transition";
        tr.innerHTML = `
          <td class="p-2.5 text-slate-400 font-mono font-medium">${index + 1}</td>
          <td class="p-2.5 font-bold text-slate-800 whitespace-nowrap">${game.date}</td>
          <td class="p-2.5 text-indigo-700 font-bold whitespace-nowrap">${game.time}</td>
          <td class="p-2.5 text-slate-800 font-medium">${game.visitor}</td>
          <td class="p-2.5 text-slate-800 font-medium">${game.home}</td>
          <td class="p-2.5 text-slate-500">${game.loc}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function openBusinessCaseModal() { document.getElementById('businessCaseModal').classList.remove('hidden'); }
    function closeBusinessCaseModal() { document.getElementById('businessCaseModal').classList.add('hidden'); }
    function openMasterScheduleModal() { document.getElementById('masterScheduleModal').classList.remove('hidden'); renderMasterScheduleTable(); }
    function closeMasterScheduleModal() { document.getElementById('masterScheduleModal').classList.add('hidden'); }

    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
